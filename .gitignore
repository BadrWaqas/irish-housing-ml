# Downloaded/generated data is regenerated by scripts/download_data.py and
# scripts/load_to_sqlite.py, and is large (the raw CSV and SQLite DB are
# both 100MB+ -- over GitHub's per-file limit), so none of it is committed.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/
env/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Env vars / secrets (none required by this project, but just in case)
.env
